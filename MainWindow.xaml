<Window x:Class="WebView2Automation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="KaHoops Arena"
        Icon="app.ico"
        Height="720" Width="1060"
        MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        WindowChrome replaces the system title bar while keeping a normal HWND.
        This matters: WPF's AllowsTransparency would force a layered window and
        WebView2 (a child HWND composited by the OS) would render as a black
        rectangle inside it. Translucency comes from the DWM acrylic backdrop
        applied in code-behind instead, which composites behind the window.

        CaptionHeight lets Windows own drag, double-click-to-maximise, Aero Snap
        and the Win+arrow shortcuts, so we do not reimplement any of it.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Caption glyphs as vectors: no dependency on Segoe MDL2 / Fluent Icons,
             which differ between Windows 10 and 11. -->
        <Geometry x:Key="GlyphMinimise">M0,0 H10</Geometry>
        <Geometry x:Key="GlyphMaximise">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
        <Geometry x:Key="GlyphRestore">M2.5,2.5 V0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z</Geometry>
        <Geometry x:Key="GlyphClose">M0,0 L10,10 M10,0 L0,10</Geometry>
        <!-- Sidebar-toggle glyph: outer frame with a vertical divider, evoking
             a browser pane + control panel — the two things this button toggles. -->
        <Geometry x:Key="GlyphPanelToggle">M0.5,0.5 H10.5 V9.5 H0.5 Z M6.5,0.5 V9.5</Geometry>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================================================================
             TITLE BAR
             ================================================================== -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="Assets/logo.png"
                       Width="18" Height="18"
                       Margin="12,0,9,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KaHoops Arena"
                               Foreground="{StaticResource Fg}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Opacity="0.9"/>

                    <!-- Profile badge: with several windows open this is the
                         only thing distinguishing them. Click for the profile
                         menu. IsHitTestVisibleInChrome is required, or the
                         caption area swallows the click and drags the window. -->
                    <Button x:Name="ProfileButton"
                            Style="{StaticResource ProfileBadge}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="ProfileButton_Click"
                            ToolTip="Switch profile, or open a new one">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ProfileLabel"
                                       Text="Default"
                                       VerticalAlignment="Center"/>
                            <Path Data="M0,0 L4,4 L8,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Margin="6,1,0,0"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="True"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Live run indicator, driven from code-behind -->
                <StackPanel Grid.Column="3"
                            x:Name="RunPill"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Visibility="Collapsed">
                    <Ellipse Width="7" Height="7"
                             Fill="{DynamicResource Accent}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>
                    <TextBlock x:Name="RunPillText"
                               Text="Running"
                               Foreground="{DynamicResource Accent}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- IsHitTestVisibleInChrome is required or the caption swallows the clicks -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- Theme colour picker: the swatch always shows the
                         currently active accent, so it doubles as a status
                         indicator, not just a button. -->
                    <Button x:Name="ThemeColorButton"
                            Style="{StaticResource CaptionButton}"
                            Click="ThemeColorButton_Click"
                            ToolTip="Change accent colour">
                        <Ellipse Width="12" Height="12"
                                 Fill="{DynamicResource Accent}"
                                 Stroke="{StaticResource Fg}"
                                 StrokeThickness="0.75"/>
                    </Button>

                    <Button x:Name="PanelToggleButton"
                            Style="{StaticResource CaptionButton}"
                            Click="PanelToggleButton_Click"
                            ToolTip="Hide control panel">
                        <Path Data="{StaticResource GlyphPanelToggle}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"/>
                    </Button>

                    <Button x:Name="MinimiseButton"
                            Style="{StaticResource CaptionButton}"
                            Click="MinimiseButton_Click"
                            ToolTip="Minimise">
                        <Path Data="{StaticResource GlyphMinimise}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"/>
                    </Button>

                    <Button x:Name="MaximiseButton"
                            Style="{StaticResource CaptionButton}"
                            Click="MaximiseButton_Click"
                            ToolTip="Maximise">
                        <Path x:Name="MaximiseGlyph"
                              Data="{StaticResource GlyphMaximise}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"/>
                    </Button>

                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseButton}"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Path Data="{StaticResource GlyphClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              SnapsToDevicePixels="True"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================================
             BODY
             ================================================================== -->
        <Grid Grid.Row="1" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition x:Name="MainSplitterColumn" Width="8"/>
                <ColumnDefinition x:Name="ControlPanelColumn" Width="470" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Browser pane -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BackButton"    Grid.Column="0" Content="&#x2190;"
                                Style="{StaticResource NavButton}" Margin="0,0,4,0"
                                Click="BackButton_Click" ToolTip="Back"/>
                        <Button x:Name="ForwardButton" Grid.Column="1" Content="&#x2192;"
                                Style="{StaticResource NavButton}" Margin="0,0,4,0"
                                Click="ForwardButton_Click" ToolTip="Forward"/>
                        <Button x:Name="ReloadButton"  Grid.Column="2" Content="&#x21BB;"
                                Style="{StaticResource NavButton}" Margin="0,0,6,0"
                                Click="ReloadButton_Click" ToolTip="Reload"/>

                        <TextBox x:Name="AddressBar" Grid.Column="3"
                                 Text="https://hoops-arena.com/match"
                                 KeyDown="AddressBar_KeyDown"/>

                        <Button x:Name="GoButton" Grid.Column="4" Content="Go"
                                Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0" Click="GoButton_Click"/>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <wv2:WebView2 x:Name="Browser"/>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="8"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Control panel + log console -->
            <Grid x:Name="ControlPanelRoot" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition x:Name="OutputRow" Height="*" MinHeight="160"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PLAY MODES"
                                       Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"
                                       Margin="0"/>
                            <Button x:Name="GameModesToggleButton" Grid.Column="1"
                                    Style="{StaticResource CollapseToggleButton}"
                                    Content="&#x25BE;"
                                    Click="GameModesToggleButton_Click"
                                    ToolTip="Minimize"/>
                        </Grid>

                        <StackPanel x:Name="GameModesContent">

                        <!-- One tab per play mode. Start/Stop and the status
                             block sit BELOW the tabs, shared: there is only one
                             runner, so Stop must stay reachable no matter which
                             tab is showing. -->
                        <TabControl x:Name="PlayModeTabs"
                                    SelectionChanged="PlayModeTabs_SelectionChanged">

                        <TabItem x:Name="ScrimmageTab" Header="SCRIMMAGE PLAY">
                        <StackPanel>

                        <TextBlock Text="HOW LONG DO YOU WANT TO PLAY?"
                                   Style="{StaticResource SectionHeader}"/>

                        <!-- One-click presets. Selecting one fills in the
                             numbers below, so nobody has to understand them. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="PresetQuick"
                                         Grid.Column="0"
                                         GroupName="Presets"
                                         Style="{StaticResource PresetChip}"
                                         Content="Quick"
                                         Tag="5 matches"
                                         Checked="Preset_Checked"/>

                            <RadioButton x:Name="PresetStandard"
                                         Grid.Column="2"
                                         GroupName="Presets"
                                         Style="{StaticResource PresetChip}"
                                         Content="Standard"
                                         Tag="25 matches"
                                         IsChecked="True"
                                         Checked="Preset_Checked"/>

                            <RadioButton x:Name="PresetFull"
                                         Grid.Column="4"
                                         GroupName="Presets"
                                         Style="{StaticResource PresetChip}"
                                         Content="Full session"
                                         Tag="Until rewards full"
                                         Checked="Preset_Checked"/>
                        </Grid>

                        <!-- Plain-language fields. Still editable, but nobody
                             needs to touch them unless they want to. -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Matches to play" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MatchCountBox" Text="25"
                                         TextChanged="Setting_Changed"
                                         ToolTip="How many scrimmage matches to play before stopping. Shows Auto when Full session is selected."/>
                                <TextBlock Text="Plays this many even if your rewards are already full."
                                           Style="{StaticResource FieldHint}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Rest between matches" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PauseSecondsBox" Text="2"
                                         TextChanged="Setting_Changed"
                                         ToolTip="Seconds to wait after each match before starting the next."/>
                                <TextBlock Text="In seconds. 2 is a safe default."
                                           Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Grid>

                        </StackPanel>
                        </TabItem>

                            <TabItem x:Name="RankTab" Header="RANK PLAY">
                                <StackPanel>

                                <TextBlock Text="HOW MANY RANKED MATCHES?"
                                           Style="{StaticResource SectionHeader}"/>

                                <TextBlock Text="Plays today's Season games first (up to 3, if any remain), then this many Ranked matches."
                                           Style="{StaticResource FieldHint}"
                                           Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Matches to play" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="RankMatchCountBox" Text="25"
                                                 ToolTip="How many Ranked matches to play before stopping."/>
                                        <TextBlock Text="Ranked matches only — Season games aren't counted here."
                                                   Style="{StaticResource FieldHint}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rest between matches" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="RankPauseSecondsBox" Text="2"
                                                 ToolTip="Seconds to wait after each match before starting the next."/>
                                        <TextBlock Text="In seconds. 2 is a safe default."
                                                   Style="{StaticResource FieldHint}"/>
                                    </StackPanel>
                                </Grid>

                                </StackPanel>
                            </TabItem>


                            <TabItem x:Name="BigThreeTab" Header="BIG3 PLAY">
                                <StackPanel>

                                <TextBlock Text="HOW MANY BIG3 SESSIONS?"
                                           Style="{StaticResource SectionHeader}"/>

                                <TextBlock Text="Queues a session, then swaps in a bench player when the target phase is reached."
                                           Style="{StaticResource FieldHint}"
                                           Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Sessions to play" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="Big3MatchCountBox" Text="25"
                                                 ToolTip="How many BIG3 sessions to play before stopping."/>
                                        <TextBlock Text="The mid-session sub is still being verified — watch it the first few times."
                                                   Style="{StaticResource FieldHint}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rest between sessions" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="Big3PauseSecondsBox" Text="2"
                                                 ToolTip="Seconds to wait after each session before starting the next."/>
                                        <TextBlock Text="In seconds. 2 is a safe default."
                                                   Style="{StaticResource FieldHint}"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="Big3SubNowButton"
                                        Content="Perform sub now"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,14,0,0"
                                        Padding="12,7"
                                        Click="Big3SubNowButton_Click"
                                        ToolTip="Manually trigger the bench substitution right now, regardless of quarter or clock."/>

                                </StackPanel>
                            </TabItem>

                        </TabControl>

                        <!-- Actions -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StartButton" Grid.Column="0"
                                    Content="&#x25B6;  Start playing"
                                    Padding="14,11"
                                    Click="StartButton_Click"/>
                            <Button x:Name="StopButton"  Grid.Column="2"
                                    Content="&#x25A0;  Stop"
                                    Style="{StaticResource DangerButton}"
                                    Padding="14,11"
                                    IsEnabled="False"
                                    Click="StopButton_Click"/>
                        </Grid>

                        <!-- Status -->
                        <Border Background="#14FFFFFF"
                                CornerRadius="6"
                                Padding="11,9"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock x:Name="StatusText"
                                           Text="Getting ready..."
                                           Foreground="{StaticResource Fg}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="StatusHint"
                                           Text="Log in to Hoops Arena in the window on the left, then press Start playing."
                                           Style="{StaticResource FieldHint}"/>

                                <ProgressBar x:Name="RunProgress"
                                             Height="4"
                                             Minimum="0" Maximum="100" Value="0"
                                             Background="#1FFFFFFF"
                                             Foreground="{DynamicResource Accent}"
                                             BorderThickness="0"
                                             Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="8"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- Pre-game actions — fire immediately when clicked. -->
                <Border Grid.Row="2"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PRE GAME SETUP"
                                       Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"
                                       Margin="0"/>
                            <Button x:Name="PreGameSetupToggleButton" Grid.Column="1"
                                    Style="{StaticResource CollapseToggleButton}"
                                    Content="&#x25BE;"
                                    Click="PreGameSetupToggleButton_Click"
                                    ToolTip="Minimize"/>
                        </Grid>

                        <StackPanel x:Name="PreGameSetupContent">

                        <TextBlock Text="Alliance Donation donates 100. Fill the tank randomly fills to capacity. Task Claiming claims all ready Alliance task rewards."
                                   Style="{StaticResource FieldHint}"
                                   Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="AllianceDonationButton" Grid.Column="0"
                                    Content="Alliance Donation"
                                    Style="{StaticResource GhostButton}"
                                    Padding="12,9"
                                    Click="AllianceDonationButton_Click"
                                    ToolTip="Opens Alliance and donates 100 to alliance funds."/>

                            <Button x:Name="FillTankButton" Grid.Column="2"
                                    Content="Fill the tank"
                                    Style="{StaticResource GhostButton}"
                                    Padding="12,9"
                                    Click="FillTankButton_Click"
                                    ToolTip="Opens the Stamina Tank and randomly fills it to capacity."/>

                            <Button x:Name="TaskClaimingButton" Grid.Column="4"
                                    Content="Task Claiming"
                                    Style="{StaticResource GhostButton}"
                                    Padding="12,9"
                                    Click="TaskClaimingButton_Click"
                                    ToolTip="Opens Tasks and claims all ready Alliance task rewards."/>
                        </Grid>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="3" Height="8"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"/>

                <Border Grid.Row="4"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="OUTPUT"
                                       Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"
                                       Margin="0"/>
                            <Button x:Name="MatchHistoryToggleButton" Grid.Column="1"
                                    Style="{StaticResource CollapseToggleButton}"
                                    Content="&#x25BE;"
                                    Click="MatchHistoryToggleButton_Click"
                                    ToolTip="Minimize"/>
                        </Grid>

                    <TabControl x:Name="OutputTabs" Grid.Row="1">

                        <!-- ============ Tab 1: live console output ============ -->
                        <TabItem Header="MATCH HISTORY">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="#59000000"
                                        BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        ClipToBounds="True">
                                    <!-- ItemsSource is assigned in the constructor to the
                                         rolling ObservableCollection; no DataContext needed. -->
                                    <DataGrid x:Name="MatchGrid" BorderThickness="0">
                                        <DataGrid.Columns>

                                            <DataGridTemplateColumn Header="OUTCOME" Width="86">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- Time moved to a tooltip: still recorded,
                                                             just not worth a column of its own. -->
                                                        <Border x:Name="Pill"
                                                                CornerRadius="3"
                                                                Padding="7,2"
                                                                HorizontalAlignment="Left"
                                                                ToolTip="{Binding TimestampText}"
                                                                Background="#2E9A9AA6">
                                                            <TextBlock x:Name="Label"
                                                                       Text="{Binding Outcome}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource FgMuted}"/>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Outcome}" Value="VICTORY">
                                                                <Setter TargetName="Pill"  Property="Background" Value="#2E5ED18E"/>
                                                                <Setter TargetName="Label" Property="Foreground" Value="#FF5ED18E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Outcome}" Value="DEFEAT">
                                                                <Setter TargetName="Pill"  Property="Background" Value="#2EF06E6E"/>
                                                                <Setter TargetName="Label" Property="Foreground" Value="#FFF06E6E"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="MINE" Width="48">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding MyScore}"
                                                                   Style="{StaticResource CellNumeric}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="OPP" Width="48">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding OpponentScore}"
                                                                   Style="{StaticResource CellNumeric}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Fixed widths on purpose: star sizing would squeeze
                                                 these to fit the panel and truncate the names. Fixed
                                                 widths let the grid overflow, which is what makes the
                                                 horizontal scrollbar appear. Both are resizable by
                                                 dragging the header edge. -->

                                            <!-- Player who earned MVP, e.g. TIM DUNCAN -->
                                            <DataGridTemplateColumn Header="MVP" Width="150" MinWidth="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding MvpName}"
                                                                   Style="{StaticResource CellText}"
                                                                   ToolTip="{Binding MvpName}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Opponent handle, e.g. [MNR] S1MPLE -->
                                            <DataGridTemplateColumn Header="OPPONENT" Width="180" MinWidth="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding OpponentName}"
                                                                   Style="{StaticResource CellMono}"
                                                                   ToolTip="{Binding OpponentName}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Running tally -->
                                <Grid Grid.Row="1" Margin="2,8,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="HistorySummary"
                                               Grid.Column="0"
                                               Text="No matches recorded yet."
                                               Foreground="{StaticResource FgMuted}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>

                                    <Button x:Name="ClearHistoryButton"
                                            Grid.Column="2"
                                            Content="Clear history"
                                            Style="{StaticResource GhostButton}"
                                            Padding="10,5"
                                            FontSize="11"
                                            Click="ClearHistoryButton_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ============ Tab 2: live activity log ============ -->
                        <TabItem Header="ACTIVITY">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="#59000000"
                                        BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <RichTextBox x:Name="LogBox"
                                                 IsReadOnly="True"
                                                 IsDocumentEnabled="True"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource Fg}"
                                                 BorderThickness="0"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                                 FontSize="11.5"
                                                 Padding="8"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto">
                                        <RichTextBox.Resources>
                                            <Style TargetType="Paragraph">
                                                <Setter Property="Margin" Value="0"/>
                                            </Style>
                                        </RichTextBox.Resources>
                                    </RichTextBox>
                                </Border>

                                <!-- Troubleshooting controls live here rather than in
                                     the setup panel: reachable when something goes
                                     wrong, invisible the rest of the time. -->
                                <Grid Grid.Row="1" Margin="2,8,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox x:Name="VerboseCheck"
                                              Grid.Column="0"
                                              Content="Show extra technical detail"
                                              VerticalAlignment="Center"
                                              ToolTip="Includes low-level diagnostic entries. Useful when reporting a problem."/>

                                    <Button x:Name="ClearLogButton"
                                            Grid.Column="1"
                                            Content="Clear"
                                            Style="{StaticResource GhostButton}"
                                            Padding="10,5"
                                            FontSize="11"
                                            Click="ClearLogButton_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                    </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
